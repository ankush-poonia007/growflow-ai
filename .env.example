# GrowFlow Environment Configuration
# Copy this file to .env and replace placeholders with real values.
# NEVER commit .env or real secrets to Git.
# Backend-only secrets must never reach the frontend.

# ============================================================
# APPLICATION
# ============================================================

APP_ENV=development
APP_NAME=GrowFlow
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
APP_SECRET_KEY=your-app-secret-key

# ============================================================
# HOSTED POSTGRESQL / SUPABASE
# ============================================================

# Hosted Supabase PostgreSQL connection.
# No local PostgreSQL server is required.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SECRET_KEY=your-backend-only-service-role-key

# Database connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# ============================================================
# SUPABASE AUTH / JWT
# ============================================================

SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=your-backend-only-jwt-verification-secret

# ============================================================
# SUPABASE STORAGE
# ============================================================

SUPABASE_STORAGE_BUCKET=growflow-documents

# ============================================================
# AI PROVIDER GATEWAY — OPENROUTER
# ============================================================

# Exactly five provider keys are available to the gateway.
# Health-aware rotation/recovery only; never use key rotation to bypass quotas.

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OPENROUTER_API_KEY_1=your-openrouter-api-key-1
OPENROUTER_API_KEY_2=your-openrouter-api-key-2
OPENROUTER_API_KEY_3=your-openrouter-api-key-3
OPENROUTER_API_KEY_4=your-openrouter-api-key-4
OPENROUTER_API_KEY_5=your-openrouter-api-key-5

# Optional OpenRouter attribution
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_X_TITLE=GrowFlow

# ============================================================
# AI MODEL CAPABILITIES
# ============================================================

# Replace with approved provider model IDs before AI execution is enabled.
AI_FAST_MODEL=choose-approved-fast-model-id
AI_STANDARD_MODEL=choose-approved-standard-model-id
AI_REASONING_MODEL=choose-approved-reasoning-model-id
AI_EMBEDDING_MODEL=choose-approved-embedding-model-id

AI_DEFAULT_MODEL=choose-approved-standard-model-id
AI_FALLBACK_MODEL=choose-approved-fallback-model-id

AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3
AI_RETRY_INITIAL_DELAY_SECONDS=1
AI_RETRY_MAX_DELAY_SECONDS=8

# ============================================================
# TAVILY — CONTROLLED WEB RESEARCH
# ============================================================

TAVILY_API_KEY=your-tavily-api-key
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic

# ============================================================
# LANGSMITH — AI TRACING / EVALUATION
# ============================================================

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=growflow-local
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ============================================================
# GITHUB OAUTH / MONITORING
# ============================================================

GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/callback
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# ============================================================
# EMAIL / GMAIL OAUTH (CONTACT DISPATCH)
# ============================================================

EMAIL_PROVIDER=gmail_oauth
EMAIL_FROM=neurachat.support@gmail.com
CONTACT_MAILBOX=neurachat.support@gmail.com

# Server-side Gmail OAuth 2.0 Credentials (never expose to client)
GMAIL_OAUTH_CLIENT_ID=your-google-oauth-client-id
GMAIL_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_OAUTH_REFRESH_TOKEN=your-google-oauth-refresh-token

# ============================================================
# RAG / DOCUMENT INTELLIGENCE
# ============================================================

RAG_ENABLED=true
RAG_TOP_K=8
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_INDEX_GENERATED_DOCUMENTS=true

# ============================================================
# FILE / DOCUMENT LIMITS
# ============================================================

MAX_UPLOAD_SIZE_MB=25
MAX_ARCHIVE_SIZE_MB=50

# ============================================================
# OBSERVABILITY / OPENTELEMETRY
# ============================================================

OTEL_SERVICE_NAME=growflow-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_ENABLED=false

# ============================================================
# BACKGROUND WORKERS
# ============================================================

WORKER_ENABLED=false
WORKER_CONCURRENCY=1
WORKER_MAX_RETRIES=3

# ============================================================
# RATE LIMITING
# ============================================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ============================================================
# SECURITY / RUNTIME
# ============================================================

SECURE_COOKIES=false
CORS_ALLOW_CREDENTIALS=true
CSRF_PROTECTION_ENABLED=true

# ============================================================
# DEVELOPMENT / TESTING
# ============================================================

DEBUG=false
TESTING=false
