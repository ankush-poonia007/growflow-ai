# ============================================================
# GrowFlow Root / Monorepo Environment Configuration
# ============================================================
# This file contains ONLY project-level and monorepo tooling configuration.
#
# ENVIRONMENT SEPARATION:
# - Backend-specific variables: See backend/.env.example
# - Frontend-specific variables: See frontend/.env.example
#
# LOCAL USAGE:
# - Copy this file to .env for local monorepo tooling if needed.
# - Actual .env files are local developer files and must NEVER be committed to Git.
# - Never put backend API keys, JWT secrets, service-role keys, or OAuth secrets in this file.
# ============================================================

# ============================================================
# PROJECT ENVIRONMENT METADATA
# ============================================================

# Global project environment tier (development, staging, production, test)
APP_ENV=development

# Project display name
APP_NAME=GrowFlow

# ============================================================
# DATABASE / MIGRATION TOOLING
# ============================================================

# Hosted Supabase PostgreSQL connection string.
# Required at the root level for repository-level Alembic CLI executions (`alembic upgrade head`).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
