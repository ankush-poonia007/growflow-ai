# ============================================================
# GrowFlow Frontend Environment
# ============================================================
# This file contains ONLY browser-safe/public configuration.
#
# Vite exposes VITE_* variables to the browser bundle.
# NEVER put backend secrets, service-role keys, private API keys,
# OAuth client secrets, database credentials, JWT secrets, or
# other confidential values in this file.
#
# Copy to .env for local development and replace placeholders.
# ============================================================


# ============================================================
# API
# ============================================================

# Backend API base URL.
#
# Local development options:
#   - Leave empty ("") to route through the Vite proxy (http://localhost:5173/api -> http://localhost:8000/api)
#   - Or set to "http://localhost:8000" for direct cross-origin API connection (requires backend APP_CORS_ORIGINS to include http://localhost:5173)
#
# Production:
#   https://api.your-production-domain.com
#
# Note: Do not include a trailing slash.
VITE_API_BASE_URL=http://localhost:8000


# ============================================================
# SUPABASE — BROWSER CLIENT
# ============================================================

# Public Supabase project URL.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Public/anonymous Supabase client key.
#
# This is safe for browser use when Supabase RLS and authorization
# are correctly configured.
#
# NEVER put SUPABASE_SECRET_KEY here.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key


# ============================================================
# APPLICATION
# ============================================================

# Frontend application environment.
#
# Supported values:
#   development
#   production
VITE_APP_ENV=development


# ============================================================
# OPTIONAL FRONTEND CONFIGURATION
# ============================================================

# Frontend application name.
VITE_APP_NAME=GrowFlow